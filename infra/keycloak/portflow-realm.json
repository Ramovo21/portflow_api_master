{
  "realm": "portflow",
  "displayName": "PortFlow",
  "displayNameHtml": "<strong>PortFlow</strong>",
  "enabled": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(10) and digits(1) and specialChars(1) and notUsername",
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "eventsExpiration": 604800,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "id": "0192f0a2-0000-7000-8000-000000000001",
        "name": "SALES"
      },
      {
        "id": "0192f0a2-0000-7000-8000-000000000002",
        "name": "SALES_MANAGER"
      },
      {
        "id": "0192f0a2-0000-7000-8000-000000000003",
        "name": "OPERATIONS"
      },
      {
        "id": "0192f0a2-0000-7000-8000-000000000004",
        "name": "OPERATIONS_LEAD"
      },
      {
        "id": "0192f0a2-0000-7000-8000-000000000005",
        "name": "ACCOUNTANT"
      },
      {
        "id": "0192f0a2-0000-7000-8000-000000000006",
        "name": "CHIEF_ACCOUNTANT"
      },
      {
        "id": "0192f0a2-0000-7000-8000-000000000007",
        "name": "LEGAL"
      },
      {
        "id": "0192f0a2-0000-7000-8000-000000000008",
        "name": "DIRECTOR"
      },
      {
        "id": "0192f0a2-0000-7000-8000-000000000009",
        "name": "ADMIN"
      }
    ]
  },
  "clients": [
    {
      "clientId": "portflow-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "portflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "portflow-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "portflow-api",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "portflow-backend",
      "enabled": true,
      "publicClient": false,
      "secret": "portflow-backend-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "portflow-dev-cli",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost/*"
      ],
      "webOrigins": [
        "http://localhost"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "portflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "portflow-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
