{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft.EntityFrameworkCore.Update": "None",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "Portflow": {
    "BusinessZone": "Asia/Ho_Chi_Minh",
    "Datasource": {
      "Url": "jdbc:postgresql://localhost:5432/portflow",
      "Username": "portflow",
      "Password": "portflow",
      "MaximumPoolSize": 20
    },
    "Rabbit": {
      "Host": "localhost",
      "Port": 5672,
      "Username": "guest",
      "Password": "guest",
      "ConfirmTimeout": "00:00:10",
      "Listener": {
        "MaxAttempts": 4,
        "InitialInterval": "00:00:01",
        "Multiplier": 3.0,
        "MaxInterval": "00:01:00"
      }
    },
    "Storage": {
      "Endpoint": "http://localhost:9000",
      "AccessKey": "portflow",
      "SecretKey": "portflow-secret",
      "Bucket": "portflow",
      "PresignTtl": "00:05:00"
    },
    "Cors": {
      "AllowedOrigins": "http://localhost:5173,http://localhost:4173"
    },
    "Jobs": {
      "Enabled": false
    },
    "Security": {
      "Jwt": {
        "Issuer": "http://localhost:8180/realms/portflow",
        "JwksUri": "http://localhost:8180/realms/portflow/protocol/openid-connect/certs",
        "Audiences": [
          "portflow-api"
        ],
        "ClockSkew": "00:00:30"
      }
    },
    "Keycloak": {
      "ServerUrl": "http://localhost:8180",
      "Realm": "portflow",
      "ClientId": "portflow-backend",
      "ClientSecret": "portflow-backend-secret",
      "PageSize": 100
    }
  }
}
